{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu22.04",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/rocker-org/devcontainer-features/miniforge:2": {}
  },
  "mounts": [
    "source=claude-code-config-${localEnv:USER}-${localWorkspaceFolderBasename},target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.local/bin/uv,target=${localEnv:HOME}/.local/bin/uv,type=bind,readonly",
    "source=${localEnv:HOME}/.local/bin/uvx,target=${localEnv:HOME}/.local/bin/uvx,type=bind,readonly",
    "source=${localEnv:HOME}/.local/share/uv/python,target=${localEnv:HOME}/.local/share/uv/python,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/uv,target=${localEnv:HOME}/.cache/uv,type=bind,consistency=cached",
    "source=${localEnv:HOME}/labrag-outputs-v1,target=${localEnv:HOME}/labrag-outputs-v1,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/labrag-run,target=${localEnv:HOME}/labrag-run,type=bind,consistency=cached,readonly",
    "source=/opt/gpu_working/steven/labrag-shared,target=/opt/gpu_working/steven/labrag-shared,type=bind,consistency=cached,readonly",
    "source=/opt/gpudata/models/StanfordAIMI/RRG_scorers,target=/opt/gpudata/models/StanfordAIMI/RRG_scorers,type=bind,consistency=cached,readonly",
    "source=/opt/gpudata/models/google-bert/bert-base-uncased,target=/opt/gpudata/models/google-bert/bert-base-uncased,type=bind,consistency=cached,readonly",
    "source=/opt/gpudata/models/microsoft/rad-dino,target=/opt/gpudata/models/microsoft/rad-dino,type=bind,consistency=cached,readonly",
    "source=/opt/gpudata/cxr,target=/opt/gpudata/cxr,type=bind,consistency=cached,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CONDA_ENVS_PATH": "${localEnv:HOME}/miniforge3/envs",
    "UV_CACHE_DIR": "${localEnv:HOME}/.cache/uv",
    "UV_PYTHON_INSTALL_DIR": "${localEnv:HOME}/.local/share/uv/python",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "PATH": "${localEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  "initializeCommand": "mkdir -p ~/.cache/uv ~/.local/share/uv/python",
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ~/.claude",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "christian-kohler.path-intellisense",
        "Anthropic.claude-code"
      ],
      "settings": {
        "workbench.colorTheme": "Dark+"
      }
    }
  }
}
